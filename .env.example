# Browser-safe values only. Copy to .env.local; never place real values in this template.
VITE_DESK_MODE=live
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# A public fallback deployment may set VITE_DESK_MODE=replay and omit both Supabase values.

# Server-only credentials are intentionally omitted.
# Configure them with Supabase secrets, never with a VITE_ prefix:
#   supabase secrets set ANTHROPIC_API_KEY=<value>
#   supabase secrets set AGENT_MODEL=claude-sonnet-5
